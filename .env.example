PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster0.ad7tkgp.mongodb.net/expense-manager?appName=Cluster0
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email — console (dev/test) | smtp | ses (future)
# Production REQUIRES smtp or ses — console is rejected at startup.
EMAIL_PROVIDER=console
EMAIL_FROM="Flux Team <noreply@example.com>"

# Required when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Example local catcher (Mailpit / MailHog) — no auth:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false

# AWS SES — required when EMAIL_PROVIDER=ses (Batch F1)
# AWS_REGION=ap-south-1
# SES_CONFIGURATION_SET=

# AI (Gemini) — optional until chat agent is wired (Batch 1+)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_LITE=gemini-3.1-flash-lite
# GEMINI_MODEL_STANDARD=gemini-3.6-flash
# GEMINI_MODEL_FALLBACK=gemini-3.5-flash,gemini-3.1-flash-lite
# AI_MODEL_FALLBACK_ENABLED=true
# AI_DEBOUNCE_MS=1500
# AI_LOG_LLM_PAYLOADS=false
# AI_PERSIST_EXECUTIONS=true
# AI_REPLY_MAX_CHARS=500
# AI_MAX_BATCH_MESSAGES=10
# ERROR_LOG_PERSIST=true
